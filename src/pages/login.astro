---
import Page from '../layouts/Page.astro';
import GitHubStar from '../components/GitHubStar.astro';
import SocialSignIn from '../components/SocialSignIn.astro';
import '../styles/login.css';
import { SKIES } from '../client/theme';
---
<Page page="login" title="Log in | Flow" bodyClass="login-page">
    <aside class="login-photo">
        <a href="/" class="brand" aria-label="Flow home">flow<i></i></a>
        <div>
            <p class="login-quote">A room, a goal, and a little momentum.</p>
            <p id="invite-note" class="invite-note hidden">You’ve been invited to room <strong id="invite-code"></strong>. Log in or create an account and you’ll go straight there.</p>
        </div>
        <GitHubStar label="Open source on GitHub" />
    </aside>
    <main class="login-main">
        <div class="theme-control">
            <label for="theme-picker">Your atmosphere</label>
            <select id="theme-picker" class="input">{SKIES.map(([id, name]) => <option value={id}>{name}</option>)}</select>
        </div>
        <section class="login-card" aria-labelledby="login-title">
            <h1 id="login-title">Welcome to your space.</h1>
            <p class="login-description">Pick up where you left off.</p>
            <SocialSignIn />
            <form id="auth-form">
                <label for="email-input">Email address</label>
                <input type="email" id="email-input" class="input" placeholder="you@example.com" autocomplete="email" required>
                <div class="pw-label"><label for="password-input">Password</label><a id="forgot-link" href="/verify.html?forgot">Forgot password?</a></div>
                <div class="password-field">
                    <input type="password" id="password-input" class="input" placeholder="At least 6 characters" autocomplete="current-password" minlength="6" required>
                    <button id="toggle-password" type="button" aria-label="Show password" aria-pressed="false">Show</button>
                </div>
                <div class="captcha" data-captcha></div>
                <div id="error-message" class="auth-message error-msg" role="alert"></div>
                <div id="success-message" class="auth-message success-msg" role="status"></div>
                <button type="submit" id="login-btn" class="btn btn-primary btn-lg btn-block">Log in</button>
                <div class="divider"><span>New to Flow?</span></div>
                <a id="signup-link" href="/start.html" class="btn btn-lg btn-block">Create an account</a>
            </form>
            <p class="login-note">Creating an account takes about a minute: your name, a sky, and how long you like to focus.</p>
        </section>
    </main>
    <script>import '../client/login';</script>
</Page>
