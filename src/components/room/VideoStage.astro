---
import Icon from '../Icon.astro';
---
<main class="main-workspace center-stage">
    <div class="stage-header">
        <h1>Study room</h1>
        <span class="stage-secure" title="Video and voice are encrypted between the browsers on this call. Flow's servers never receive them."><Icon name="lock" size={13} />Encrypted call</span>
        <span id="connection-status" class="stage-status" role="status" data-state="connecting">Connecting…</span>
    </div>
    <!-- First session only: three things to try, ticked off as they happen. -->
    <div id="room-guidance" class="checklist hidden">
        <h2>Your first session</h2>
        <ol>
            <li data-check="invite"><button id="invite-empty-btn" type="button">Invite someone</button></li>
            <li data-check="task">Add a task you’ll finish</li>
            <li data-check="timer">Start the sun</li>
        </ol>
    </div>
    <div class="video-grid" id="video-grid">
        <div class="video-wrapper" id="video-wrapper-local">
            <video id="local-video" autoplay muted playsinline></video>
            <span class="name-tag">You</span>
            <!-- Stepping away dims your tile and pauses your focus time; the room's sun carries on. -->
            <button id="toggle-away" class="away-btn" type="button" aria-pressed="false">Be right back</button>
            <div class="dummy-placeholder hidden" id="local-dummy-placeholder">
                <div class="avatar" id="local-dummy-avatar">?</div>
                <div class="text">Camera unavailable</div>
            </div>
            <details class="reactions-menu">
                <summary class="icon-btn" aria-label="Reactions and raise hand"><Icon name="smile" /></summary>
                <div class="reaction-bar">
                    <button class="icon-btn reaction-btn" data-emoji="👍" data-kind="thumbsUp" aria-label="Thumbs up"><Icon name="thumbsUp" /></button>
                    <button class="icon-btn reaction-btn" data-emoji="❤️" data-kind="heart" aria-label="Heart"><Icon name="heart" /></button>
                    <button class="icon-btn reaction-btn" data-emoji="😂" data-kind="laugh" aria-label="Laugh"><Icon name="laugh" /></button>
                    <button class="icon-btn reaction-btn" data-emoji="🎉" data-kind="party" aria-label="Celebrate"><Icon name="party" /></button>
                    <button id="toggle-hand" class="icon-btn" aria-label="Raise hand" aria-pressed="false" title="Raise hand"><Icon name="hand" /></button>
                </div>
            </details>
            <div class="media-controls">
                <button id="toggle-mic" class="icon-btn toggle active" aria-label="Toggle microphone" aria-pressed="true" title="Microphone (M)"><Icon name="mic" class="on" /><Icon name="micOff" class="off" /></button>
                <button id="toggle-cam" class="icon-btn toggle active" aria-label="Toggle camera" aria-pressed="true" title="Camera (V)"><Icon name="cam" class="on" /><Icon name="camOff" class="off" /></button>
            </div>
        </div>
    </div>
</main>
