---
import GitHubStar from '../GitHubStar.astro';
import Icon from '../Icon.astro';
import { SUBJECTS, CAMERAS, VIBES } from '../../client/modules/board-options';
const shortcuts = [['S', 'Start or pause the timer'], ['F', 'Enter or leave focus mode'], ['M', 'Mute or unmute your microphone'], ['V', 'Turn your camera on or off'], ['C', 'Open chat and start a message'], ['N', 'Open notifications'], ['?', 'Show these shortcuts'], ['Esc', 'Close a dialog']];
---
<div id="modal-overlay" class="modal-overlay">
    <!-- Home: the first thing after signing in. Who you are on the left, what you can do on the right. -->
    <div id="join-modal" class="modal home" role="dialog" aria-modal="true" aria-labelledby="join-title">
        <aside class="home-profile">
            <a href="/" class="brand">flow<i></i></a>
            <div class="home-me">
                <div class="avatar" id="home-avatar">?</div>
                <div>
                    <h1 id="join-title">Welcome back.</h1>
                    <button type="button" id="home-edit-name" class="link-btn">Change name</button>
                </div>
            </div>
            <form id="home-name-form" class="input-row hidden">
                <input type="text" id="home-name-input" class="input" aria-label="Your display name" maxlength="40" required>
                <button class="btn btn-primary">Save</button>
            </form>
            <div id="home-stats" class="home-stats" aria-live="polite"></div>
            <p id="lobby-recap" class="home-recap"></p>
            <div class="lobby-footer"><a href="#" id="logout-link" class="logout-link">Log out</a><a href="/docs.html" class="logout-link">How Flow works</a><GitHubStar label="Star" /></div>
        </aside>

        <div class="home-main">
            <!-- First visit only: shown until the account has a display name. -->
            <form id="welcome-step" class="hidden">
                <h2>First, what should we call you?</h2>
                <p class="lobby-description">Your study partners see this name on your video tile and next to your tasks.</p>
                <label for="welcome-name-input">Your name</label>
                <input type="text" id="welcome-name-input" class="input" maxlength="40" autocomplete="nickname" required>
                <p id="welcome-error" class="inline-error hidden" role="alert"></p>
                <button id="welcome-save-btn" class="btn btn-primary btn-lg btn-block">Save and continue</button>
                <p class="lobby-note">You can change it any time from this screen.</p>
            </form>

            <div id="lobby-step">
                <h2 id="lobby-greeting">What would you like to do?</h2>
                <p id="lobby-error" class="inline-error hidden" role="alert"></p>
                <div class="home-actions">
                    <section class="home-card" aria-labelledby="start-heading">
                        <h3 id="start-heading">Start a room</h3>
                        <p>Your own room, ready in a second.</p>
                        <fieldset class="home-choice">
                            <legend>Who is it for?</legend>
                            <label><input type="radio" name="audience" value="private" checked><span><strong>People I invite</strong>Share the link or code with friends.</span></label>
                            <label><input type="radio" name="audience" value="open"><span><strong>Anyone studying this</strong>Listed on the study-groups board.</span></label>
                        </fieldset>
                        <div id="create-private">
                            <label for="create-pin-input">Lock it with a PIN <span class="muted">(optional)</span></label>
                            <input type="text" id="create-pin-input" class="input" placeholder="4 digits" maxlength="4" inputmode="numeric" autocomplete="off">
                        </div>
                        <div id="create-open" class="hidden">
                            <label for="create-topic" class="visually-hidden">Topic for the board</label>
                            <input type="text" id="create-topic" class="input" maxlength="80" placeholder="What are you studying?">
                            <!-- The listing's details fit on one line; changing them opens a panel over the card, so Home never scrolls. -->
                            <details id="create-details" class="create-details">
                                <summary><span id="create-summary"></span> <span class="link-btn">Change</span></summary>
                                <div class="create-details-panel" role="group" aria-label="Group details">
                            <div class="home-row">
                                <div><label for="create-subject">Subject</label><select id="create-subject" class="input">{SUBJECTS.map(([id, name]) => <option value={id} selected={id === 'other'}>{name}</option>)}</select></div>
                                <div><label for="create-seats">Seats</label><select id="create-seats" class="input">{[2, 3, 4, 5, 6].map(n => <option value={n} selected={n === 4}>{n}</option>)}</select></div>
                            </div>
                            <div class="home-row even">
                                <div><label for="create-camera">Cameras</label><select id="create-camera" class="input">{CAMERAS.map(([id, name]) => <option value={id}>{name.replace('Cameras ', '').replace(/^./, letter => letter.toUpperCase())}</option>)}</select></div>
                                <div><label for="create-vibe">Talking</label><select id="create-vibe" class="input">{VIBES.map(([id, name]) => <option value={id}>{name}</option>)}</select></div>
                            </div>
                                    <button type="button" id="create-details-done" class="btn btn-primary btn-block">Done</button>
                                </div>
                            </details>
                        </div>
                        <button id="host-btn" class="btn btn-primary btn-lg btn-block" disabled>Create a room</button>
                    </section>

                    <section class="home-card" aria-labelledby="join-heading">
                        <h3 id="join-heading">Join with a code</h3>
                        <p id="join-hint">Someone sent you a link or a six-character code.</p>
                        <label for="room-code-input">Room code</label>
                        <input type="text" id="room-code-input" class="input room-code-field" aria-describedby="lobby-error" placeholder="ABC123" maxlength="6" autocomplete="off" spellcheck="false" data-autofocus>
                        <label for="room-pin-input">Room PIN <span class="muted">(only if it has one)</span></label>
                        <input type="text" id="room-pin-input" class="input" placeholder="4 digits" maxlength="4" inputmode="numeric" autocomplete="off">
                        <button id="join-btn" class="btn btn-lg btn-block" disabled>Join room</button>
                    </section>

                    <section class="home-card" aria-labelledby="find-heading">
                        <h3 id="find-heading">Find a study group</h3>
                        <p id="lobby-board">Sit down with people studying the same thing.</p>
                        <ul id="home-groups" class="home-groups"></ul>
                        <a href="/groups.html" class="btn btn-lg btn-block">Browse all groups</a>
                    </section>
                </div>
            </div>
        </div>
    </div>

    <div id="timer-settings-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="timer-settings-title">
        <div class="modal-head"><h2 id="timer-settings-title">Timer settings</h2><button id="close-timer-settings-btn" class="icon-btn quiet" aria-label="Close timer settings"><Icon name="close" /></button></div>
        <p class="dialog-description">Lengths apply to everyone in the room.</p>
        <div class="settings-grid">
            <div><label for="setting-focus-duration">Focus (minutes)</label><input type="number" id="setting-focus-duration" required class="input" value="25" min="1" max="120"></div>
            <div><label for="setting-short-break-duration">Short break (minutes)</label><input type="number" id="setting-short-break-duration" required class="input" value="5" min="1" max="60"></div>
            <div><label for="setting-long-break-duration">Long break (minutes)</label><input type="number" id="setting-long-break-duration" required class="input" value="15" min="1" max="60"></div>
        </div>
        <label class="check"><input type="checkbox" id="setting-notify"><span>Send me system notifications<small>For finished sessions, new chat messages, and reminders, only while Flow is in a background tab.</small></span></label>
        <label class="check"><input type="checkbox" id="setting-hide-ip"><span>Hide my IP address<small>Calls go through a relay server, so others in the room never see your address. Adds a little delay. On by default in groups from the study-groups board.</small></span></label>
        <button id="save-timer-settings-btn" class="btn btn-primary btn-block">Save Changes</button>
    </div>

    <div id="profile-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="profile-title">
        <div class="modal-head"><h2 id="profile-title">Your profile</h2><button id="close-profile-btn" class="icon-btn quiet" aria-label="Close profile"><Icon name="close" /></button></div>
        <div class="profile-name-form">
            <div id="profile-avatar" class="avatar">?</div>
            <div>
                <label for="profile-display-name-input">Display name</label>
                <div class="input-row">
                    <input type="text" id="profile-display-name-input" required class="input" placeholder="Your name" maxlength="40">
                    <button id="save-profile-name-btn" class="btn btn-primary">Save Name</button>
                </div>
            </div>
        </div>
        <div id="profile-stats" aria-live="polite"></div>
        <p class="profile-footnote">All your focus time is saved, including blocks you pause or leave part-way. Only blocks that run to the end count as sessions.</p>
    </div>

    <div id="timer-alert-modal" class="modal hidden centered" role="dialog" aria-modal="true" aria-labelledby="timer-alert-title">
        <h2 id="timer-alert-title">Time’s up</h2>
        <p id="timer-alert-msg" class="dialog-description">Great focus session.</p>
        <button id="close-timer-alert-btn" class="btn btn-primary btn-block">Continue</button>
    </div>

    <div id="leave-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="leave-title">
        <h2 id="leave-title">Leave this session?</h2>
        <p id="leave-text" class="dialog-description">Your camera and microphone will disconnect. You can rejoin with the room code; saved shared tasks stay in the room.</p>
        <!-- Shown to the host only: what happens to the room when they go. -->
        <fieldset id="leave-host" class="leave-host hidden">
            <legend>You’re the host. What should happen to the room?</legend>
            <label id="leave-handover-row"><input type="radio" name="leave-choice" value="handover"><span><strong>Hand it to <select id="leave-new-host" class="input" aria-label="New host"></select></strong><small>The room, and its board listing if it has one, carry on with them as host.</small></span></label>
            <label><input type="radio" name="leave-choice" value="away"><span><strong>Step away</strong><small id="leave-away-text">The room stays open. Whoever is here hosts for now, and the role comes back to you when you return.</small></span></label>
            <label><input type="radio" name="leave-choice" value="end"><span><strong>End the room for everyone</strong><small id="leave-end-text">Closes the room for good: everyone is sent Home and the code stops working. Tasks and focus time are kept.</small></span></label>
        </fieldset>
        <div class="dialog-actions">
            <button id="cancel-leave-btn" class="btn">Stay in room</button>
            <button id="confirm-leave-btn" class="btn btn-danger">Leave room</button>
        </div>
    </div>

    <div id="invite-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="invite-title">
        <h2 id="invite-title">Invite your study group</h2>
        <p class="dialog-description">Anyone with this link can join after signing in. Room code <strong id="invite-code-text"></strong>.</p>
        <label for="invite-link-input">Room link</label>
        <div class="input-row">
            <input id="invite-link-input" class="input" readonly>
            <button id="copy-invite-btn" class="btn btn-primary"><Icon name="copy" size={16} /><span>Copy link</span></button>
        </div>
        <form id="board-form" class="board-form">
            <h3>Or open it to the study-groups board</h3>
            <p id="board-status" class="panel-description" role="status">Anyone signed in can find it and take a seat. Rooms with a PIN can’t be listed.</p>
            <label for="board-topic">What are you studying?</label>
            <input type="text" id="board-topic" class="input" minlength="3" maxlength="80" required placeholder="Organic chemistry revision">
            <div class="board-form-grid">
                <select id="board-subject" class="input" aria-label="Subject">{SUBJECTS.map(([id, name]) => <option value={id} selected={id === 'other'}>{name}</option>)}</select>
                <select id="board-camera" class="input" aria-label="Cameras">{CAMERAS.map(([id, name]) => <option value={id}>{name}</option>)}</select>
                <select id="board-vibe" class="input" aria-label="Talking">{VIBES.map(([id, name]) => <option value={id}>{name}</option>)}</select>
            </div>
            <div class="board-form-row">
                <label for="board-seats">Seats</label>
                <select id="board-seats" class="input" aria-label="Seats, including you">{[2, 3, 4, 5, 6].map(n => <option value={n} selected={n === 4}>{n}</option>)}</select>
                <button id="board-list-btn" class="btn btn-primary">List this room</button>
                <button type="button" id="board-unlist-btn" class="btn hidden">Take off the board</button>
            </div>
            <label id="board-closed-row" class="check hidden"><input type="checkbox" id="board-closed"><span>Stop new people joining<small>The listing stays up and shows as closed. People already here are not affected.</small></span></label>
        </form>
        <div class="dialog-actions"><button id="close-invite-btn" class="btn">Done</button></div>
    </div>

    <div id="remove-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="remove-title">
        <h2 id="remove-title">Remove this person?</h2>
        <p id="remove-text" class="dialog-description">They will leave the room now and won’t be able to come back to it.</p>
        <div class="dialog-actions">
            <button id="cancel-remove-btn" class="btn">Keep them</button>
            <button id="confirm-remove-btn" class="btn btn-danger">Remove from room</button>
        </div>
    </div>

    <div id="shortcuts-modal" class="modal hidden" role="dialog" aria-modal="true" aria-labelledby="shortcuts-title">
        <div class="modal-head"><h2 id="shortcuts-title">Keyboard shortcuts</h2><button id="close-shortcuts-btn" class="icon-btn quiet" aria-label="Close shortcuts"><Icon name="close" /></button></div>
        <dl class="shortcut-list">{shortcuts.map(([key, action]) => <div><dt><kbd>{key}</kbd></dt><dd>{action}</dd></div>)}</dl>
        <p class="profile-footnote">Shortcuts pause while you’re typing.</p>
    </div>
</div>
