---
import Icon from '../Icon.astro';
import { SKIES } from '../../client/theme';
---
<header class="app-header">
    <div class="header-left">
        <a href="/" class="brand" aria-label="Flow home">flow<i></i></a>
        <div class="room-info">
            <span id="room-name">Room <button type="button" class="highlight" id="header-room-code" aria-label="Copy room code" title="Copy room code">----</button></span>
            <span class="participant-count"><span class="dot green"></span><span id="count">1</span> here</span>
        </div>
    </div>
    <div class="header-right">
        <div class="me-chip" id="my-presence-card" role="button" tabindex="0" aria-label="Edit your profile" title="Your profile and focus history">
            <div class="avatar" id="my-avatar">?</div>
            <div class="me-copy">
                <strong id="my-username">You</strong>
                <span class="status-indicator"><span class="dot green"></span><span id="my-status-text">Online</span><span id="my-focus-time">Today: 0m focused</span></span>
            </div>
        </div>
        <details id="notify" class="notify">
            <summary id="notify-summary" class="icon-btn" aria-label="Notifications"><Icon name="bell" /><span id="notify-count" class="notify-count hidden" aria-hidden="true">0</span></summary>
            <div class="notify-panel">
                <div class="notify-head"><h2>Notifications</h2><button id="notify-clear" type="button" class="link-btn">Clear</button></div>
                <p id="notify-empty" class="panel-description">Nothing yet. Messages, arrivals, and finished sessions show up here.</p>
                <ul id="notify-list"></ul>
            </div>
        </details>
        <button id="open-shortcuts-btn" class="icon-btn" aria-label="Keyboard shortcuts" title="Keyboard shortcuts (?)"><Icon name="keyboard" /></button>
        <select id="theme-picker" class="input" aria-label="Room atmosphere">{SKIES.map(([id, name]) => <option value={id}>{name}</option>)}</select>
        <button id="share-link-btn" class="btn">Invite</button>
        <button id="leave-btn" class="btn btn-danger">Leave</button>
    </div>
</header>
