---
import '@fontsource-variable/bricolage-grotesque/wdth.css';
import '../styles/global.css';
interface Props { title?: string; page?: string; }
const { title = 'Flow | Study better, together', page = '' } = Astro.props;
const description = 'A shared space for focused study. Set a timer, work on your goals, and study better together with Flow.';
const image = 'https://flow-study.me/social-preview-lake.jpg';
const imageAlt = 'flow-study.me, centered over a dreamy, blurred blue lake framed by soft green grasses.';
// Every public page points at itself. The room is behind a login and has no
// public content, so it (like the built index) keeps the home page.
const homePaths = new Set(['/index.html', '/room.html']);
const pageUrl = new URL(homePaths.has(Astro.url.pathname) ? '/' : Astro.url.pathname, Astro.site ?? new URL('https://flow-study.me/'));
---
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={pageUrl.href}>
<meta property="og:type" content="website">
<meta property="og:site_name" content="Flow">
<meta property="og:locale" content="en_US">
<meta property="og:url" content={pageUrl.href}>
<meta property="og:title" content="Flow | Study better, together">
<meta property="og:description" content={description}>
<meta property="og:image" content={image}>
<meta property="og:image:type" content="image/jpeg">
<meta property="og:image:width" content="1200">
<meta property="og:image:height" content="630">
<meta property="og:image:alt" content={imageAlt}>
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="Flow | Study better, together">
<meta name="twitter:description" content={description}>
<meta name="twitter:image" content={image}>
<meta name="twitter:image:alt" content={imageAlt}>
<!-- The default sky's top colour; src/client/theme.ts keeps it in step with the chosen sky. -->
<meta name="theme-color" content="#0b2a22">
<link rel="icon" type="image/svg+xml" href="/favicon.svg">
<link rel="manifest" href="/manifest.webmanifest">
<!-- Before first paint: saved sky, sign-in redirects, and the once-per-session opening. -->
<script is:inline src="/js/boot.js" data-page={page}></script>
