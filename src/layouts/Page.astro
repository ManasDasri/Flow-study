---
import { readFileSync } from 'node:fs';
import Head from '../components/Head.astro';
import Loader from '../components/Loader.astro';
interface Props { title?: string; bodyClass?: string; page?: string; }
const { title, bodyClass, page } = Astro.props;
// `npm run dev:demo` swaps Supabase for the test fixture so the app runs offline.
// import.meta.env.DEV is false in every build, so this never ships.
const demo = import.meta.env.DEV && process.env.FLOW_DEMO ? readFileSync('scripts/supabase-fixture.js', 'utf8') : null;
---
<!doctype html>
<html lang="en">
    <head>
        <Head title={title} page={page} />
        {demo && <script is:inline set:html={demo + "\nif (new URLSearchParams(location.search).has('nocam') && navigator.mediaDevices) navigator.mediaDevices.getUserMedia = async () => { throw new Error('Camera skipped in demo'); };"}></script>}
        <slot name="head" />
    </head>
    <body class={bodyClass}>
        <Loader message={page === 'room' ? 'Getting your space ready' : 'One moment'} />
        <slot />
        <script>
            import '../client/speed-insights';
            import { releaseWhenLoaded } from '../client/loader';
            import { homeLinks } from '../client/nav';
            import { syncThemeColor } from '../client/theme';
            homeLinks();
            syncThemeColor();
            releaseWhenLoaded();
        </script>
    </body>
</html>
