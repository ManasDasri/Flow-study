{
  "name": "flow",
  "version": "1.0.0",
  "description": "A shared study room: one timer, shared tasks, and your study group on camera.",
  "main": "server.js",
  "engines": {
    "node": "^22.23.4 || ^24.0.0 || ^26.0.0"
  },
  "scripts": {
    "test": "node --test scripts/server.test.cjs scripts/utils.test.cjs scripts/focus-progress.test.cjs scripts/host-state.test.cjs",
    "start": "node server.js",
    "dev": "astro dev",
    "test:db": "node --test scripts/sql-integration.test.cjs",
    "test:browser": "node scripts/browser-ci.cjs",
    "check:live": "node scripts/check-live.cjs",
    "preview:social": "node scripts/generate-social-preview.cjs",
    "icons": "node scripts/generate-app-icons.cjs",
    "build": "astro build",
    "check": "astro check",
    "pretest": "npm run check && npm run build",
    "dev:demo": "FLOW_DEMO=1 astro dev",
    "marketing:images": "node scripts/generate-marketing.cjs"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@supabase/supabase-js": "^2.119.0",
    "astro": "^7.4.7",
    "dotenv": "^18.0.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.3",
    "groq-sdk": "^1.6.0",
    "gsap": "^3.15.1",
    "twilio": "^6.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "cookie": "^2.0.2",
    "esbuild": "^0.28.2",
    "playwright": "1.65.0",
    "typescript": "^6.0.3"
  },
  "license": "MIT"
}
